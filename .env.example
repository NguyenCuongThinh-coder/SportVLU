# Reference for environment variables; app.py does not auto-load .env.
# Export values in your shell or configure them in your IDE. Never commit secrets.
SPORTSLOT_ENV=development
SPORTSLOT_SECRET_KEY=replace-with-a-random-local-secret
SPORTSLOT_DB_PATH=sportslot.db
SPORTSLOT_ALLOW_EMPTY_DB=0
SPORTSLOT_SEED_DEMO=0
SPORTSLOT_DEBUG=0
SPORTSLOT_COOKIE_SECURE=0

# Optional email/reset-password settings
SPORTSLOT_SMTP_HOST=
SPORTSLOT_SMTP_PORT=587
SPORTSLOT_SMTP_FROM=
SPORTSLOT_SMTP_USER=
SPORTSLOT_SMTP_PASSWORD=
SPORTSLOT_SMTP_SSL=0
SPORTSLOT_PUBLIC_URL=http://127.0.0.1:5000
